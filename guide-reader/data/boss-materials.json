    "derivation": {
      "characterScope": "All 122 distinct ChineseSimplified character records at the pinned genshin-db commit, including separate 空/荧 and 奇偶·男性/奇偶·女性 identities.",
      "bossMaterialRule": "mapped requires exactly one rarity-4 AVATAR_MATERIAL whose exact numeric ID occurs once in each of ascend2 through ascend6; the emitted name is read from that same material record.",
      "noneRule": "none means every ascend2-through-ascend6 cost list contains no cataloged normal-boss material ID. A null bossMaterial must be interpreted with bossRequirement and never as unread data or zero demand.",
      "unknownRule": "unknown is reserved for missing, conflicting, or ambiguous stage evidence; its bossMaterial remains null. This pinned source produced no unknown character mappings.",
      "normalBossMaterialRule": "Materials are limited to rarity-4 AVATAR_MATERIAL records with an exact sourceTexts entry in the game source form 30级以上…掉落; gems, weekly-boss materials, and common enemy drops are excluded.",
      "supportRule": "supported is true only when one complete sourceTexts entry exactly wraps one BetterGI AutoBossData supported name as 30级以上<name>掉落. Shared aliases and names absent from BetterGI remain boss:null and supported:false.",
      "sourceTextRule": "sourceTexts preserves the exact normalized Chinese strings from each pinned MIT material record; no alias is synthesized from a material name or substring."
    }
  },
